/validation/synthetic/ground_truth_enrichment.csv
/validation/synthetic/results/cluster_bootstrap_per_row.csv
/validation/synthetic/results/mrr_per_row.csv

# Silent-error audit ledger
audit_dispositions.csv
audit_dispositions.csv.*

# local-only, real-study config — never commit/ship
real_data_config.yaml
AGENTS.md
