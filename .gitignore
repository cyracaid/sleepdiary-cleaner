manual_error_correction_updated.csv
reasonable_unusual_records.csv
cross_participant_field_misentries.csv
cross_participant_flagged_rows.csv
cross_participant_suspicious_slices.csv
# Local-only verification reports (real-data aggregates). Never pushed.
verify_reports/
# Manuscript notes for direct email attachment to coauthors -- contain real
# participant identifiers (pid 6490, pid 1036 etc.) in prose/tables, unlike
# the git-tracked validation/ docs which are kept scrubbed. Never commit.
manuscript_notes/
# pipeline review outputs written to project_dir root (real-pid data, regenerated each run)
\[NEW\]*.csv
# testthat failure artifacts
tests/testthat/_problems/
# MAIA-facing docs with real pid mentions (1036/6490/10599) — local only.
/docs/
# pkgdown build artifacts (regenerated by pkgdown::build_site).
/pkgdown/
# pipeline run cache key (regenerated per input sha)
validation/synthetic/run_ppv/input_key.txt
