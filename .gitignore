disambiguation_worksheet_cyra.csv
disambiguation_worksheet_maia.csv
disambiguation_agreement_report.csv
disambiguation_disagreements.csv
disambiguation_already_resolved.csv
# v2 renamed worksheets (2026-09-08) -- same real-data privacy rule
manual_disambiguation_*.csv
# Tiered fasttrack/fullreview split (v7->v8) + the user-facing review sheet
# rebuild_fasttrack_complete.R writes -- these carry real pid/day_num/
# timestamps exactly like the files above and were missing from this list
# (found 2026-09-18 while adding provenance tracking; fasttrack_review.csv
# was sitting untracked-but-not-ignored in `git status` before this fix).
disambiguation_worksheet_tiered_fasttrack.csv
disambiguation_worksheet_tiered_fullreview_cyra.csv
disambiguation_worksheet_tiered_fullreview_maia.csv
fasttrack_review.csv
# Provenance sidecars follow their parent CSV's ignore status (no real data
# in the sidecar itself, but if the CSV is gitignored the record of exactly
# which run produced it should not leak into git independently either).
*.csv.provenance.json
# Pre-overwrite snapshots (validation/_snapshots/) taken by
# rebuild_fasttrack_complete.R before it overwrites manual_disambiguation_
# fasttrack.csv in place -- same real-data content as that file.
validation/_snapshots/
