# Raw data (never commit)
*.rds
!inst/extdata/*.rds
# Real-data anon exports (local only, placeholder-named in config_default.yaml)
sber_ema_anon_*.csv

# Worklog (local only)
worklog/
# Manual correction CSVs (contain participant identifiers)
# NOTE the *.bak* / *.csv.* patterns below: on 2026-08-09 a backup created as
# manual_error_corrections.csv.bak_20260808 showed up as untracked, because the
# exact-filename patterns here do not match a suffixed copy. Any hand-made
# backup of a real-data CSV must stay out of git.
*.bak
*.bak_*
manual_*.csv.*
second_review_checklist.csv.*
metrics_ai_review.csv.*
manual_error_corrections.csv
manual_unusual_corrections.csv
manual_nap_exercise_corrections.csv
manual_sleep_metric_duration_corrections.csv
manual_metric_review_acceptances.csv
second_review_checklist.csv
metrics_ai_review.csv
# Pipeline output
# Figure output. NOTE the trailing * before the slash: run directories are named
# latest_visualization_real_n13990/ etc., so a bare "latest_visualization/"
# pattern would NOT match them and real-data figures would be committed.
sleep_visualization_*/
latest_visualization*/
output/
output_*/
Rplots.pdf
# Verification artifacts (snapshot .rds pairs, Bland-Altman plots, audit
# reports) written by verification_run_dir() (R/config.R). Real-data ones
# land under output/ and are already covered by the "output/" rule above;
# this anchored rule (leading slash) additionally catches the project-root
# copy used for synth/unknown runs. Anchored so it does NOT match
# inst/verification/ (the tracked verification *scripts*, not their output).
/verification/
# Archive & old code
archive/
visualizations/
# Binary / data files (never commit)
*.docx
*.xlsx
*.numbers
*.pdf
*.zip
SPL/
# R
.Rproj.user/
.Rhistory
.RData
.Renv
# renv: activate.R + settings.json + renv.lock are COMMITTED (standard renv
# workflow: the autoloader must exist on CI checkout or .Rprofile's
# source("renv/activate.R") crashes every R step). Only the local library
# cache and staging dir are ignored.
renv/library/
renv/staging/
renv/python/
renv/sandbox/
# macOS
.DS_Store
# Package build
*.tar.gz
src/
sleepcleanr.Rcheck/
