/timegap_candidates_3to6h.csv
/timegap_candidates_summary.csv
# Private correspondence (local only).
/manual_inputs_docs/
# Personal work logs (local only).
/work_logs/
# Unpublished manuscript + figures (local only; JOSS submission separate).
/paper/
/figures/
# internal agent plans (local only)
/docs-dev/superpowers/
