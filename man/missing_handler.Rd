% Generated by hand — corresponds to R/missing_handler.R
\name{missing_handler}
\alias{handle_missing}
\alias{summarise_missing}
\title{Missing-data reason codes and single-day LOCF}
\description{
  Adds a \code{missing_reason} column that distinguishes why a row has
  incomplete data.  Optionally applies last-observation-carried-forward
  (LOCF) to metric columns for single-day gaps.  Timestamp columns are
  never imputed; all filled values carry a \code{_imputed} companion
  column for audit trail.
}
\usage{
handle_missing(data, timestamp_cols = NULL, metric_cols = NULL,
               group_col = "pid", order_col = "day_num", max_gap = 1L)
summarise_missing(data, group_col = "pid")
}
\arguments{
  \item{data}{A data frame from the pipeline.}
  \item{timestamp_cols}{Character vector of POSIXct timestamp columns.}
  \item{metric_cols}{Character vector of columns eligible for LOCF.}
  \item{group_col}{Participant identifier column.}
  \item{order_col}{Within-participant ordering column.}
  \item{max_gap}{Maximum consecutive missing days to fill (0 disables).}
}
\value{
  \code{handle_missing()} returns \code{data} with a \code{missing_reason}
  column and, when \code{max_gap > 0}, \code{<col>_imputed} companion
  columns.

  \code{summarise_missing()} returns per-participant counts of each
  missing reason and imputed value.
}
